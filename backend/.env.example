# Copy this file to backend/.env and fill in values locally.
# Never commit backend/.env.

# Supabase: Project Settings → Database → Connection string → URI
# Replace the password placeholder. Prefer the Session pooler URI if the
# direct connection fails on your network.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require

# First-account ID used by setup_tutor.py. API requests use the authenticated
# session instead; the browser cannot choose a tutor ID.
TUTOR_ID=tut_local

# Generate locally with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep this stable across restarts, private, and different from your DB password.
FLASK_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

# Use 1 only for local development. Production cookies require HTTPS.
FLASK_DEBUG=1
PORT=5000
