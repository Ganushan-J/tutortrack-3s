# Copy this file to backend/.env and fill in values locally.
# Never commit backend/.env.

# Supabase: Project Settings → Database → Connection string → URI
# Replace the password placeholder. Prefer the Session pooler URI if the
# direct connection fails on your network.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require

# Single-tutor bootstrap until work package 3 adds sessions.
# All queries are scoped to this id; the browser cannot choose it.
TUTOR_ID=tut_local

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

FLASK_DEBUG=1
PORT=5000
